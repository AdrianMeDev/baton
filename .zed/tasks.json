[
  { "label": "test", "command": "uv run pytest -q", "reveal": "always" },
  { "label": "lint", "command": "uv run ruff check", "reveal": "always" },
  { "label": "format", "command": "uv run ruff format", "reveal": "always" },
  { "label": "doctor", "command": "uv run baton doctor", "reveal": "always" },
  {
    "label": "baton next",
    "command": "uv run baton next",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "baton auto",
    "command": "uv run baton auto",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  }
]
